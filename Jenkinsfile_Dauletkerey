pipeline {
  agent any

  environment {
    DOCKERHUB_USER = "dauletkerey"
    IMAGE_NAME     = "devops-app"
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        sh 'git rev-parse --short HEAD'
      }
    }

    stage('Prepare Vars') {
      steps {
        script {
          env.SHORT_COMMIT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
          env.IMAGE_TAG    = "build-${env.BUILD_NUMBER}-${env.SHORT_COMMIT}"
          env.FULL_IMAGE   = "${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.IMAGE_TAG}"
          env.LATEST_IMAGE = "${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest"
        }
        sh '''
          echo "SHORT_COMMIT=$SHORT_COMMIT"
          echo "IMAGE_TAG=$IMAGE_TAG"
          echo "FULL_IMAGE=$FULL_IMAGE"
          echo "LATEST_IMAGE=$LATEST_IMAGE"
        '''
      }
    }

    stage('Build (Maven)') {
      steps {
        sh 'mvn -B -U clean package -DskipTests'
      }
      post {
        success {
          archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
        }
      }
    }

    stage('Test (Maven)') {
      steps {
        sh 'mvn -B test'
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
        }
      }
    }

    stage('Static Analysis (optional)') {
      steps {
        sh '''
          set +e
          mvn -B checkstyle:check spotbugs:check
          EXIT_CODE=$?
          if [ $EXIT_CODE -ne 0 ]; then
            echo "Static analysis not passed or plugins missing (optional)."
          fi
          exit 0
        '''
      }
    }

    stage('Docker Build') {
      steps {
        sh '''
          set -e
          docker build -f Dockerfile_Dauletkerey -t "$FULL_IMAGE" .
          docker tag "$FULL_IMAGE" "$LATEST_IMAGE"
        '''
      }
    }

    stage('Docker Push') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'dockerhub-creds',
          usernameVariable: 'DUSER',
          passwordVariable: 'DPASS'
        )]) {
          sh '''
            set -e
            echo "$DPASS" | docker login -u "$DUSER" --password-stdin
            docker push "$FULL_IMAGE"
            docker push "$LATEST_IMAGE"
            docker logout
          '''
        }
      }
    }

    stage('Deploy (main only)') {
      when {
        branch 'main'
      }
      steps {
        sh '''
          set -e
          docker compose -f docker-compose_Dauletkerey.yml pull app
          docker compose -f docker-compose_Dauletkerey.yml up -d
          docker compose -f docker-compose_Dauletkerey.yml ps
        '''
      }
    }
  }

  post {
    success {
      echo "✅ Pipeline SUCCESS: ${env.FULL_IMAGE}"
    }
    failure {
      echo "❌ Pipeline FAILED. Check console output."
    }
    always {
      sh 'docker image prune -f || true'
    }
  }
}
