pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    // ✅ твой путь проекта в VM
    APP_DIR    = '.'

    // ✅ твои кастомные имена файлов
    DOCKERFILE = 'Dockerfile_Dauletkerey'
    COMPOSE    = 'docker-compose_Dauletkerey.yml'

    // ✅ твой Docker image (Docker Hub)
    IMAGE_REPO = 'tg/todo-app'

    // ✅ Jenkins Credentials ID для Docker registry (DockerHub)
    REG_CREDS  = 'dockerhub-creds'

    // ❌ не нужен в твоём проекте (оставляем пустым, но не используем ниже)
    PG_ENV_ID  = ''
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          def sha = sh(returnStdout: true, script: 'git rev-parse --short=7 HEAD').trim()
          def b   = (env.BRANCH_NAME ?: 'manual').replaceAll('[^A-Za-z0-9_.-]','-')
          env.IMAGE_TAG = "${b}-${env.BUILD_NUMBER}-${sha}"
          env.APP_IMAGE = "${env.IMAGE_REPO}:${env.IMAGE_TAG}"
          env.REG_HOST  = ''   // ✅ DockerHub: логин без host
        }
      }
    }

    stage('Build') {
      steps {
        dir(env.APP_DIR) {
          sh '''
            set -e
            mvn -B clean package -DskipTests
          '''
        }
      }
    }

    stage('Test') {
      steps {
        dir(env.APP_DIR) {
          sh '''
            set -e
            mvn -B test
          '''
        }
        junit allowEmptyResults: true, testResults: "${APP_DIR}/target/surefire-reports/*.xml"
      }
    }

    stage('Static Analysis (optional)') {
      steps {
        dir(env.APP_DIR) {
          sh '''
            set -e
            # ✅ опционально: если плагинов нет — не валим билд
            mvn -B checkstyle:check spotbugs:check || true
          '''
        }
      }
    }

    stage('Docker Build (dynamic tag)') {
      steps {
        dir(env.APP_DIR) {
          sh '''
            set -e
            docker build -t "$APP_IMAGE" -f "$DOCKERFILE" .
          '''
        }
      }
    }

    stage('Docker Push') {
      steps {
        withCredentials([usernamePassword(credentialsId: "${REG_CREDS}", usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
          sh '''
            set -e
            echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin
            docker push "$APP_IMAGE"
            docker logout
          '''
        }
      }
    }

    stage('Deploy (main only)') {
      when { branch 'main' }
      steps {
        dir(env.APP_DIR) {
          sh '''
            set -e
            # ✅ деплойим именно тот образ, что собрали/запушили
            APP_TAG="${IMAGE_TAG}" docker compose -f "$COMPOSE" up -d --no-build
            docker compose -f "$COMPOSE" ps
          '''
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: '**/target/*.jar', allowEmptyArchive: true
    }
  }
}
