pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    // ====== НАСТРОЙ ПОД СЕБЯ ======
    DOCKER_REGISTRY = "docker.io"
    DOCKER_REPO     = "dauletkerey/devops-app"  // например: dauletkerey/todo-app
    DOCKER_CREDS_ID = "dockerhub-creds"

    // Maven
    MAVEN_OPTS = "-Dmaven.repo.local=.m2/repository"

    // (Опционально) email (если поставишь Email Extension plugin и настроишь SMTP)
    // EMAIL_TO = "you@example.com"
  }

  stages {

    stage("Checkout") {
      steps {
        retry(3) {
          checkout([$class: 'GitSCM',
            branches: [[name: '*/main']],
            userRemoteConfigs: [[
              url: 'git@github.com:xo-dltkry/todo-devops.git',
              credentialsId: 'git-ssh'
            ]],
            extensions: [
              [$class: 'CleanBeforeCheckout'],
              [$class: 'CloneOption', shallow: true, depth: 1, noTags: true, timeout: 20]
            ]
          ])
        }
      }
    }

    stage("Build (Maven)") {
      steps {
        sh '''
          set -e
          mvn -v
          mvn -DskipTests=true clean package
        '''
      }
    }

    stage("Test (Maven)") {
      steps {
        sh '''
          set -e
          mvn test
        '''
      }
    }

    stage("Static Analysis (optional)") {
      when { expression { fileExists("pom.xml") } }
      steps {
        sh '''
          set -e
          echo "Run Checkstyle/SpotBugs only if configured in pom.xml"
          # Если в pom.xml настроены плагины checkstyle/spotbugs, эти команды отработают.
          # Если нет — они могут упасть. Тогда либо добавь плагины, либо закомментируй stage.
          mvn -DskipTests=true checkstyle:check || true
          mvn -DskipTests=true spotbugs:check  || true
        '''
      }
    }

    stage("Prepare Docker Tag") {
      steps {
        script {
          def shortCommit = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
          def ts = sh(script: "date +%Y%m%d-%H%M%S", returnStdout: true).trim()
          env.IMAGE_TAG = "${env.BUILD_NUMBER}-${shortCommit}-${ts}"
          env.FULL_IMAGE = "${env.DOCKER_REPO}:${env.IMAGE_TAG}"
          echo "IMAGE_TAG=${env.IMAGE_TAG}"
          echo "FULL_IMAGE=${env.FULL_IMAGE}"
        }
      }
    }

    stage("Docker Build") {
      steps {
        sh '''
          set -e
          docker version
          docker build -t "$FULL_IMAGE" .
        '''
      }
    }

    stage("Docker Push") {
      steps {
        withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDS_ID}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
          sh '''
            set -e
            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
            docker push "$FULL_IMAGE"
            docker logout
          '''
        }
      }
    }

    stage("Deploy (main only)") {
      when {
        branch "main"
      }
      steps {
        sh '''
          set -e
          echo "Deploying only on main..."
          # Вариант 1 (локально на той же VM): обновить docker-compose
          # Требование: на сервере должен быть docker-compose.yml, который использует образ.
          #
          # Пример:
          #   services:
          #     app:
          #       image: YOUR_DOCKERHUB_LOGIN/YOUR_IMAGE_NAME:latest
          #
          # Тогда можно пушить latest дополнительно и делать pull/up.
          #
          # --- Простой способ: tag also as latest ---
          docker tag "$FULL_IMAGE" "$DOCKER_REPO:latest"
          docker push "$DOCKER_REPO:latest"

          # Если у тебя docker-compose лежит например в /opt/devops-project (поменяй путь):
          if [ -f /opt/devops-project/docker-compose.yml ]; then
            cd /opt/devops-project
            docker compose pull
            docker compose up -d
            docker compose ps
          else
            echo "No /opt/devops-project/docker-compose.yml found. Skipping compose deploy."
          fi
        '''
      }
    }
  }

  post {
    always {
      // Артефакты Maven (jar/war)
      archiveArtifacts artifacts: 'target/*.jar,target/*.war', fingerprint: true

      // Логи + чистка workspace (по желанию)
      echo "Build finished: ${currentBuild.currentResult}"
    }

    success {
      echo "SUCCESS ✅"
      // Если настроишь Email Extension plugin:
      // emailext to: "${EMAIL_TO}",
      //   subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
      //   body: "Image: ${env.FULL_IMAGE}\nBuild URL: ${env.BUILD_URL}"
    }

    failure {
      echo "FAILURE ❌"
      // emailext to: "${EMAIL_TO}",
      //   subject: "FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
      //   body: "Check console output:\n${env.BUILD_URL}"
    }
  }
}
